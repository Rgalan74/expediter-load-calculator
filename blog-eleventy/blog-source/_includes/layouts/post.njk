{% set esPath = "blog/" ~ (page.fileSlug if lang == "es" else translationSlug) ~ ".html" %}
{% set enPath = "en/blog/" ~ (page.fileSlug if lang == "en" else translationSlug) ~ ".html" %}
{% set canonicalPath = esPath if lang == "es" else enPath %}
{% set rootPrefix = "/" if lang == "es" else "/en/" %}

<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EK7NM7PJE2"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-EK7NM7PJE2');
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ metaTitle }}</title>
  <link rel="canonical" href="https://smartloadsolution.com/{{ canonicalPath }}">
  <link rel="alternate" hreflang="es" href="https://smartloadsolution.com/{{ esPath }}">
  <link rel="alternate" hreflang="en" href="https://smartloadsolution.com/{{ enPath }}">
  <link rel="alternate" hreflang="x-default" href="https://smartloadsolution.com/{{ enPath }}">

  <!-- SEO Meta Tags -->
  <meta name="description" content="{{ metaDescription }}">
  <!-- OpenGraph -->
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://smartloadsolution.com/{{ canonicalPath }}">
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDescription }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://smartloadsolution.com/{{ canonicalPath }}">
  <meta name="twitter:title" content="{{ twitterTitle }}">
  <meta name="twitter:description" content="{{ twitterDescription }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <!-- Styles -->
  <link rel="icon" type="image/webp" href="/img/logo-app.webp">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0a0a0f;
      --bg-glass: rgba(15, 15, 25, 0.7);
      --primary-cyan: #00D9FF;
      --primary-orange: #FF6B35;
      --border-glass: rgba(255, 255, 255, 0.08);
    }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg-dark);
      color: #e2e8f0;
      line-height: 1.8;
      overflow-x: hidden;
    }
    .gradient-text {
      background: linear-gradient(90deg, #00D9FF 0%, #FF6B35 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .glass-card {
      background: var(--bg-glass);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-glass);
      border-radius: 16px;
    }
    .callout {
      padding: 1.5rem;
      border-radius: 12px;
      margin: 2rem 0;
      border-left: 4px solid;
    }
    .callout.tip {
      background: rgba(0, 217, 255, 0.06);
      border-color: var(--primary-cyan);
    }
    .callout.warning {
      background: rgba(255, 107, 53, 0.06);
      border-color: var(--primary-orange);
    }
    .table-container {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-glass);
      border-radius: 12px;
      overflow: hidden;
      margin: 1.5rem 0;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
    th {
      background: rgba(0, 217, 255, 0.08);
      color: var(--primary-cyan);
      font-weight: 700;
    }
    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
      font-weight: 600;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s;
    }
    .btn-secondary:hover {
      background: rgba(0, 217, 255, 0.05);
      border-color: var(--primary-cyan);
      color: var(--primary-cyan);
    }
    .lang-toggle button {
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      color: #9ca3af;
      transition: color 0.2s;
    }
    .lang-toggle button.active {
      color: var(--primary-cyan);
    }
    .post-card {
      transition: transform 0.25s, border-color 0.25s;
    }
    .post-card:hover {
      transform: translateY(-4px);
      border-color: rgba(0, 217, 255, 0.3);
    }
  </style>
  <!-- Meta Pixel Code -->
  <script>
    !function (f, b, e, v, n, t, s) {
      if (f.fbq) return; n = f.fbq = function () {
        n.callMethod ?
        n.callMethod.apply(n, arguments) : n.queue.push(arguments)
      };
      if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0';
      n.queue = []; t = b.createElement(e); t.async = !0;
      t.src = v; s = b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t, s)
    }(window, document, 'script',
      'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '2077223159668765');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=2077223159668765&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel Code -->
  <!-- Metricool Tracker -->
  <script>function loadScript(a) { var b = document.getElementsByTagName("head")[0], c = document.createElement("script"); c.type = "text/javascript", c.src = "https://tracker.metricool.com/resources/be.js", c.onreadystatechange = a, c.onload = a, b.appendChild(c) } loadScript(function () { beTracker.t({ hash: "7da74d6dfb9767939b3eb010fa322db6" }) });</script>
  <!-- End Metricool Tracker -->
  <!-- Article Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | dump | safe }},
    "description": {{ metaDescription | dump | safe }},
    "image": "{{ ogImage }}",
    "author": {
      "@type": "Person",
      "name": {{ author | dump | safe }}
    },
    "publisher": {
      "@type": "Organization",
      "name": "Smart Load Solution",
      "logo": {
        "@type": "ImageObject",
        "url": "https://smartloadsolution.com/img/logo-app.webp"
      }
    },
    "datePublished": "{{ date | isoDate }}",
    "dateModified": "{{ dateModified | default(date) | isoDate }}",
    "mainEntityOfPage": "https://smartloadsolution.com/{{ canonicalPath }}"
  }
  </script>
  {% if faqs %}
  <!-- FAQ Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": {{ faq.question | dump | safe }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ faq.answer | dump | safe }}
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
</head>
<body>
  <!-- HEADER -->
  <header style="position: sticky; top: 0; z-index: 100; background: rgba(10,10,15,0.95); border-bottom: 1px solid var(--border-glass);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem;">
      <div class="flex items-center justify-between">
        <a href="{{ rootPrefix }}index.html" class="flex items-center gap-3">
          <img src="/img/logo-app.webp" alt="SmartLoad Solution Logo" class="h-10 w-auto" onerror="this.src='/img/logo-app.png'">
          <span class="text-xl font-bold text-white">Smart Load Solution</span>
        </a>
        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
          <a href="{{ rootPrefix }}index.html" class="text-gray-300 hover:text-white transition" data-i18n="about.nav_home">{{ blogStrings[lang].navHome }}</a>
          <a href="{{ rootPrefix }}about.html" class="text-gray-300 hover:text-white transition" data-i18n="about.nav_about">{{ blogStrings[lang].navAbout }}</a>
          <a href="{{ rootPrefix }}blog.html" class="text-gray-300 hover:text-white transition" data-i18n="about.nav_blog">{{ blogStrings[lang].navBlog }}</a>
          <a href="{{ rootPrefix }}resources.html" class="text-gray-300 hover:text-white transition" data-i18n="about.nav_resources">{{ blogStrings[lang].navResources }}</a>
          <a href="{{ rootPrefix }}plans.html" class="text-gray-300 hover:text-white transition" data-i18n="about.nav_plans">{{ blogStrings[lang].navPlans }}</a>
        </nav>
        <div class="flex items-center gap-4">
          <div class="lang-toggle hidden md:flex items-center gap-1 font-semibold text-xs">
            {% if lang == "es" %}
            <a id="btn-en" href="https://smartloadsolution.com/{{ enPath }}" onclick="localStorage.setItem('app_language','en')" style="text-decoration:none;cursor:pointer;padding:0.2rem 0.4rem;border-radius:4px;color:#9ca3af;transition:color 0.2s;">EN</a>
            <span style="color:#4b5563;">|</span>
            <button id="btn-es" style="background:none;border:none;cursor:default;padding:0.2rem 0.4rem;border-radius:4px;color:#00D9FF;font-weight:700;" aria-current="true">ES</button>
            {% else %}
            <button id="btn-en" style="background:none;border:none;cursor:default;padding:0.2rem 0.4rem;border-radius:4px;color:#00D9FF;font-weight:700;" aria-current="true">EN</button>
            <span style="color:#4b5563;">|</span>
            <a id="btn-es" href="https://smartloadsolution.com/{{ esPath }}" onclick="localStorage.setItem('app_language','es')" style="text-decoration:none;cursor:pointer;padding:0.2rem 0.4rem;border-radius:4px;color:#9ca3af;transition:color 0.2s;">ES</a>
            {% endif %}
          </div>
          <a href="{{ rootPrefix }}auth.html" class="hidden md:inline-block bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold py-2 px-4 rounded-lg transition" data-i18n="about.nav_login">{{ blogStrings[lang].navLogin }}</a>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="max-w-4xl mx-auto px-6 py-12">
    <div class="text-xs text-gray-500 mb-6">
      <a href="{{ rootPrefix }}blog.html" class="text-cyan-400 hover:underline">{{ blogStrings[lang].navBlog }}</a>
      <span class="mx-2">/</span>
      <span>{{ title }}</span>
    </div>

    <article>
      {% if heroImage %}
      <img src="/img/blog/{{ heroImage }}" alt="{{ heroImageAlt or title }}" class="w-full h-auto rounded-2xl mb-8" loading="eager" width="1600" height="840">
      {% endif %}
      <header class="mb-10">
        <span class="inline-block bg-cyan-900/40 text-cyan-400 text-xs font-semibold px-3 py-1 rounded-full mb-4">{{ category }}</span>
        <h1 class="text-3xl md:text-5xl font-black text-white leading-tight mb-4">{{ title }}</h1>
        <div class="flex items-center gap-3 text-sm text-gray-500">
          {% if authorPhoto %}
          <img src="/img/blog/{{ authorPhoto }}" alt="{{ author }}" class="w-10 h-10 rounded-full object-cover border border-white/10">
          {% endif %}
          <span>{{ blogStrings[lang].byLabel }}: <strong>{{ author }}</strong></span>
          <span>•</span>
          <span>{{ blogStrings[lang].readTimeLabel }}: {{ readTime }} min</span>
        </div>
      </header>

      <div class="prose prose-invert max-w-none text-gray-300 text-base md:text-lg">
        {{ content | safe }}
      </div>

      {% if faqs %}
      <div class="mt-12 pt-8 border-t border-white/10">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-6">{{ blogStrings[lang].faqSectionTitle }}</h2>
        <div class="space-y-4">
          {% for faq in faqs %}
          <div class="glass-card p-5">
            <h3 class="text-base md:text-lg font-semibold text-white mb-2">{{ faq.question }}</h3>
            <p class="text-gray-300 text-sm md:text-base">{{ faq.answer }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <!-- Author bio -->
      <div class="glass-card p-6 flex items-center gap-4 my-10">
        {% if authorPhoto %}
        <img src="/img/blog/{{ authorPhoto }}" alt="{{ author }}" class="w-16 h-16 rounded-full object-cover border border-white/10 flex-shrink-0">
        {% endif %}
        <div>
          <div class="font-bold text-white">{{ author }}</div>
          <div class="text-cyan-400 text-sm mb-1">{{ blogStrings[lang].authorBioHandle }}</div>
          <p class="text-gray-400 text-sm">{{ blogStrings[lang].authorBioText }}</p>
        </div>
      </div>

      <!-- Lead Magnet CTA -->
      <div class="glass-card p-8 text-center my-12 border-cyan-500/20 border">
        <h3 class="text-2xl font-bold text-white mb-3">{{ blogStrings[lang].ctaTitle }}</h3>
        <p class="text-gray-400 mb-6 max-w-lg mx-auto text-sm md:text-base">{{ blogStrings[lang].ctaBody }}</p>
        <a href="{{ rootPrefix }}auth.html" class="inline-block bg-gradient-to-r from-cyan-400 to-orange-500 hover:from-cyan-500 hover:to-orange-600 text-white font-bold py-3 px-8 rounded-lg shadow-lg transform hover:-translate-y-0.5 transition duration-300">
          {{ blogStrings[lang].ctaButton }}
        </a>
      </div>

      <!-- Sigue leyendo -->
      {% set relatedCollection = collections.postsEs if lang == "es" else collections.postsEn %}
      {% set related = relatedCollection | relatedPosts(page.url, category, 3) %}
      {% if related.length > 0 %}
      <div class="mt-4">
        <h3 class="text-xl md:text-2xl font-bold text-white mb-6">{{ blogStrings[lang].relatedPostsTitle }}</h3>
        <div class="grid md:grid-cols-3 gap-6">
          {% for post in related %}
          <a href="{{ post.url }}" class="post-card glass-card overflow-hidden block">
            <img src="/img/blog/{{ post.data.heroImage }}" alt="{{ post.data.heroImageAlt or post.data.title }}" class="w-full h-32 object-cover">
            <div class="p-4">
              <span class="inline-block bg-cyan-900/40 text-cyan-400 text-xs font-semibold px-3 py-1 rounded-full mb-2">{{ post.data.category }}</span>
              <h4 class="text-sm font-bold text-white leading-snug">{{ post.data.title }}</h4>
            </div>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </article>
  </main>

  <!-- FOOTER -->
  <footer style="padding: 4rem 1.5rem 2rem; background: var(--bg-dark); border-top: 1px solid rgba(255,255,255,0.1);">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-4">
            <img src="/img/logo-app.webp" alt="SmartLoad Solution" class="h-8 w-auto" onerror="this.src='/img/logo-app.png'">
            <span class="font-bold text-lg text-white">SmartLoad</span>
          </div>
          <p class="text-gray-400 text-sm leading-relaxed" data-i18n="about.footer_tagline">{{ blogStrings[lang].footerTagline }}</p>
        </div>
        <div>
          <h4 class="font-bold text-white mb-4" data-i18n="about.footer_col_company">{{ blogStrings[lang].footerColCompany }}</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="{{ rootPrefix }}about.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_about">{{ blogStrings[lang].footerAbout }}</a></li>
            <li><a href="{{ rootPrefix }}plans.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_plans">{{ blogStrings[lang].footerPlans }}</a></li>
            <li><a href="{{ rootPrefix }}contact.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_contact">{{ blogStrings[lang].footerContact }}</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-white mb-4" data-i18n="about.footer_col_resources">{{ blogStrings[lang].footerColResources }}</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="{{ rootPrefix }}resources.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_resources">{{ blogStrings[lang].footerResources }}</a></li>
            <li><a href="{{ rootPrefix }}blog.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_blog">{{ blogStrings[lang].navBlog }}</a></li>
            <li><a href="{{ rootPrefix }}faq.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_faq">{{ blogStrings[lang].footerFaq }}</a></li>
            <li><a href="{{ rootPrefix }}support.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_support">{{ blogStrings[lang].footerSupport }}</a></li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-white mb-4" data-i18n="about.footer_col_legal">{{ blogStrings[lang].footerColLegal }}</h4>
          <ul class="space-y-2 text-sm mb-4">
            <li><a href="{{ rootPrefix }}privacy.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_privacy">{{ blogStrings[lang].footerPrivacy }}</a></li>
            <li><a href="{{ rootPrefix }}terms.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_terms">{{ blogStrings[lang].footerTerms }}</a></li>
            <li><a href="{{ rootPrefix }}refund.html" class="text-gray-400 hover:text-white transition" data-i18n="about.footer_refund">{{ blogStrings[lang].footerRefund }}</a></li>
          </ul>
          <!-- Social Media Links -->
          <div class="flex gap-4 mt-4">
            <a href="https://www.facebook.com/galan.expediter" aria-label="Facebook" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-blue-500 transition-all duration-300">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"></path>
              </svg>
            </a>
            <a href="https://www.tiktok.com/@galan.expediter" aria-label="TikTok" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-cyan-400 transition-all duration-300">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.525.02c1.31-.03 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.17-2.86-.74-3.94-1.73-.22-.2-.43-.41-.62-.63-.19 1.79-.75 3.56-1.68 5.11-1.25 2.08-3.23 3.75-5.55 4.54-2.58.88-5.51.78-8.01-.47-2.73-1.37-4.63-4.14-4.9-7.19-.38-4.22 2.11-8.39 6.08-9.84 2.17-.79 4.62-.81 6.78-.05 0 2.18-.01 4.36-.02 6.54-1.25-.43-2.67-.32-3.81.39-.99.62-1.76-1.59 2.93.01 1.73 1.48 3.19 3.22 3.13 1.61-.05 2.94-1.35 3.01-2.95V.02z"></path>
              </svg>
            </a>
            <a href="https://www.instagram.com/galan.expediter/" aria-label="Instagram" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-pink-500 transition-all duration-300">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.008 3.885.058 1.357.062 2.367.274 3.111.562a5.82 5.82 0 012.08 1.354 5.83 5.83 0 011.353 2.08c.288.743.5 1.754.562 3.112.05 1.102.059 1.458.059 3.885s-.008 2.784-.059 3.886c-.062 1.357-.274 2.367-.562 3.111a5.82 5.82 0 01-1.353 2.08 5.82 5.82 0 01-2.08 1.353c-.744.288-1.754.5-3.112.563-1.102.049-1.458.058-3.885.058s-2.784-.008-3.886-.058c-1.356-.062-2.367-.274-3.11-.563a5.82 5.82 0 01-2.08-1.353 5.83 5.83 0 01-1.353-2.08c-.287-.743-.5-1.754-.562-3.112C2.008 14.784 2 14.428 2 12s.008-2.784.058-3.885c.062-1.358.274-2.367.562-3.112a5.83 5.83 0 011.353-2.08 5.82 5.82 0 012.08-1.353c.743-.288 1.754-.5 3.112-.562C9.528 2.008 9.884 2 12 2h.315zM12 5.802a6.197 6.197 0 100 12.396 6.197 6.197 0 000-12.396zm0 2.22a3.977 3.977 0 110 7.954 3.977 3.977 0 010-7.954zm6.474-.756a1.218 1.218 0 11-2.437 0 1.218 1.218 0 012.437 0z" clip-rule="evenodd"></path>
              </svg>
            </a>
            <a href="https://www.youtube.com/@galan.expediter" aria-label="YouTube" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-red-500 transition-all duration-300">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C22 8.68 22 12 22 12s0 3.32-.42 4.814c-.23.861-.907 1.538-1.768 1.768C18.32 19 12 19 12 19s-6.32 0-7.812-.418c-.861-.23-1.538-.907-1.768-1.768C2 15.32 2 12 2 12s0-3.32.42-4.814c.23-.861.907-1.538 1.768-1.768C5.68 5 12 5 12 5s6.32 0 7.812.418zM9.75 15.02l5.75-3.02-5.75-3.02v6.04z" clip-rule="evenodd"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div class="text-center pt-8 border-t border-gray-800">
