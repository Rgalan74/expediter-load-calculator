rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdminByRole() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Verifica si el usuario intenta modificar campos de roles
    function isModifyingRoleFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleAssignedBy', 'roleAssignedAt', 'permissions']);
    }

    // lexTrialEndsAt se puede fijar al crear el perfil (registro) pero no
    // cambiarse despues; accountStatus/adminNotes/manualPlanOverride solo los
    // escribe adminUpdateUser via Admin SDK.
    function isModifyingServerOwnedFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan', 'subscriptionStatus', 'subscriptionId', 'loadsThisMonth', 'monthStartDate',
        'lexTrialEndsAt', 'accountStatus', 'adminNotes', 'manualPlanOverride'
      ]);
    }

    // Al crear el perfil el cliente NO puede sembrar campos server-owned ni de
    // rol: sin esto, un usuario creaba su users/{uid} con role: 'admin' y
    // obtenia acceso total al panel de administracion.
    function hasNoServerOwnedFieldsAtCreate() {
      return !request.resource.data.keys().hasAny([
        'plan', 'subscriptionStatus', 'subscriptionId', 'loadsThisMonth', 'monthStartDate',
        'accountStatus', 'adminNotes', 'manualPlanOverride',
        'role', 'roleAssignedBy', 'roleAssignedAt', 'permissions'
      ]);
    }

    // mail: solo destinatario propio y solo los campos del mensaje. Sin esto se
    // podian agregar cc/bcc/from y usar el dominio para mandar correo a terceros.
    function isMailToSelf() {
      let to = request.resource.data.to;
      return (to is string && to == request.auth.token.email) ||
             (to is list && to.size() == 1 && to[0] == request.auth.token.email);
    }

    function hasRequiredFields() {
      return request.resource.data.keys().hasAll([
        'userId', 'origin', 'destination', 'totalMiles', 'rpm', 'totalCharge'
      ]);
    }
    
    function hasValidNumbers() {
      let data = request.resource.data;
      return data.rpm >= 0 && data.rpm <= 50 &&
             data.totalMiles >= 0 && data.totalMiles <= 10000 &&
             data.totalCharge >= 0 && data.totalCharge <= 500000;
    }
    
    // ========================================
    // LOADS COLLECTION
    // ========================================
    match /loads/{loadId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      allow create: if false;

      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid &&
                       hasRequiredFields() &&
                       hasValidNumbers();

      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }

    // ========================================
    // EXPENSES COLLECTION
    // ========================================
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // LEX AI - PROFILES
    // ========================================
    match /lexProfiles/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);  // write = create + update + delete
    }
    
    // ========================================
    // LEX AI - ANALYSES
    // ========================================
    match /lexAnalyses/{analysisId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow update, delete: if isAuthenticated() &&
                               resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // LEX AI - CONVERSATIONS
    // ========================================
    match /lexConversations/{conversationId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow update, delete: if isAuthenticated() &&
                               resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // SMART LOAD ACADEMY - PROGRESS TRACKING
    // Document ID = userId (ver academy.js _docRef())
    // ========================================
    match /academyProgress/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);  // write = create + update + delete
    }

    // ========================================
    // MARKET/ZONE NOTES
    // ========================================
    match /notes/{noteId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;
      
      allow create, update: if isAuthenticated() &&
                               request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // USER PLANS
    // ========================================
    match /userPlans/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) &&
                       !exists(/databases/$(database)/documents/userPlans/$(userId));
      
      allow update: if false;
      allow delete: if false;
    }
    
    // ========================================
    // ANALYTICS
    // ========================================
    match /analytics/{eventId} {
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow read, update, delete: if false;
    }

    // ========================================
    // STRIPE EXTENSION
    // ========================================
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;
      
      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }

    match /products/{id} {
      allow read: if true;
      
      match /prices/{id} {
        allow read: if true;
      }
      
      match /tax_rates/{id} {
        allow read: if true;
      }
    }
    
    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // Lectura: usuario puede leer su propio perfil, admins pueden leer todos
      allow read: if isOwner(userId) || isAdminByRole();
      
      // Creación: usuario puede crear su propio perfil, pero no puede sembrar
      // campos server-owned (plan/suscripcion/contador de cargas) con valores
      // propios -- esos siempre empiezan ausentes y el codigo ya trata su
      // ausencia como el default seguro (free / 0 cargas).
      allow create: if isOwner(userId) && hasNoServerOwnedFieldsAtCreate();

      // Actualización NORMAL (sin tocar roles ni campos server-owned):
      // Usuario puede actualizar su perfil EXCEPTO campos de roles y los
      // campos que solo debe tocar el Admin SDK (activateUserPlan, adminUpdateUser,
      // createLoad)
      allow update: if isOwner(userId) && !isModifyingRoleFields() && !isModifyingServerOwnedFields();
      
      // Actualización de ROLES:
      // Solo admins pueden modificar roles
      allow update: if isAdminByRole() && isModifyingRoleFields();

      // Eliminación: solo via Cloud Function deleteUserAccount (Admin SDK).
      // Borrar y recrear el perfil desde el cliente reiniciaba el contador de
      // cargas del mes y dejaba la suscripcion de Stripe cobrando.
      allow delete: if false;

      match /checkout_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // ========================================
    // EMAIL (trigger-email extension)
    // ========================================
    match /mail/{docId} {
      // Solo el propio usuario puede crear emails dirigidos a su cuenta
      allow create: if isAuthenticated() &&
                       request.auth.token.email != null &&
                       request.resource.data.keys().hasAll(['to', 'message']) &&
                       request.resource.data.keys().hasOnly(['to', 'message']) &&
                       isMailToSelf() &&
                       request.resource.data.message is map &&
                       request.resource.data.message.keys().hasOnly(['subject', 'html', 'text']);
    }

    // ========================================
    // LEADS (captura landing page — sin auth)
    // ========================================
    match /leads/{leadId} {
      // Landing page lead capture: solo crear, nunca leer/editar
      // Validar campos mínimos para evitar spam masivo
      allow create: if request.resource.data.keys().hasAll(['email', 'name']) &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() <= 200 &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() <= 100;
      allow read, update, delete: if false;
    }

    // ========================================
    // LEX AI - ALERTAS PROACTIVAS (Phase 5)
    // Cloud Function escribe vía Admin SDK (bypass rules)
    // Cliente solo lee y actualiza (marcar como leídas)
    // ========================================
    match /alerts/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid);
    }

    // ========================================
    // APP CONFIG (precios de Stripe, etc.)
    // Solo lectura para usuarios autenticados — nunca escritura desde cliente.
    // appConfig/openrouter (API key de Lex AI) NO es legible desde el cliente:
    // solo la lee la Cloud Function lexChat via Admin SDK.
    // ========================================
    match /appConfig/{configId} {
      allow read: if isAuthenticated() && configId != 'openrouter';
      allow write: if false;
    }

    // ========================================
    // DENY ALL ELSE
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
