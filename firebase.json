{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "redirects": [
      { "source": "/blog/calculate-real-rpm.html", "destination": "/en/blog/calculate-real-rpm.html", "type": 301 },
      { "source": "/blog/decide-load-30-seconds.html", "destination": "/en/blog/decide-load-30-seconds.html", "type": 301 },
      { "source": "/blog/hidden-operating-costs.html", "destination": "/en/blog/hidden-operating-costs.html", "type": 301 },
      { "source": "/blog/llc-vs-sole-proprietor.html", "destination": "/en/blog/llc-vs-sole-proprietor.html", "type": 301 },
      { "source": "/blog/profitable-zones.html", "destination": "/en/blog/profitable-zones.html", "type": 301 },
      { "source": "/es/blog/como-calcular-rpm-real.html", "destination": "/blog/como-calcular-rpm-real.html", "type": 301 },
      { "source": "/es/blog/costos-ocultos-operacion.html", "destination": "/blog/costos-ocultos-operacion.html", "type": 301 },
      { "source": "/es/blog/decidir-carga-en-30-segundos.html", "destination": "/blog/decidir-carga-en-30-segundos.html", "type": 301 },
      { "source": "/es/blog/llc-vs-propietario-unico.html", "destination": "/blog/llc-vs-propietario-unico.html", "type": 301 },
      { "source": "/es/blog/zonas-rentables-expediters.html", "destination": "/blog/zonas-rentables-expediters.html", "type": 301 }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "img-backups/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.tailwindcss.com cdn.jsdelivr.net www.gstatic.com cdnjs.cloudflare.com connect.facebook.net maps.googleapis.com www.googletagmanager.com tracker.metricool.com analytics.ahrefs.com; style-src 'self' 'unsafe-inline' cdn.tailwindcss.com cdn.jsdelivr.net fonts.googleapis.com; font-src 'self' fonts.googleapis.com fonts.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://openrouter.ai https://api.weatherapi.com https://api.rainviewer.com https://tilecache.rainviewer.com https://tile.openweathermap.org https://www.googletagmanager.com https://www.google-analytics.com https://*.gstatic.com https://cdnjs.cloudflare.com https://us-central1-expediter-dev.cloudfunctions.net https://api.emailjs.com https://cdn.jsdelivr.net https://api.brevo.com https://tracker.metricool.com https://analytics.ahrefs.com; img-src 'self' data: https://www.facebook.com https://smartloadsolution.com https://app.smartloadsolution.com https://maps.googleapis.com https://maps.gstatic.com https://www.googletagmanager.com https://tracker.metricool.com; frame-src 'none'; object-src 'self'; base-uri 'self'"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico|JPG|JPEG|GIF|PNG|SVG|WEBP|ICO)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|htm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/landing",
        "destination": "/landing/index.html"
      },
      {
        "source": "/landing/**",
        "destination": "/landing/index.html"
      },
      {
        "source": "!/@(img|css|js|landing|en|es)/**",
        "destination": "/index.html"
      }
    ]
  }
}